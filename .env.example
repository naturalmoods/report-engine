# Copy as .env (chmod 600). In production: $VPS_PATH/.env on the server, read by deploy/compose.prod.yaml.

TZ=Europe/Budapest
# For local runs leave empty/delete (default: ./data/report-engine.db); in the container /data/report-engine.db
DATABASE_PATH=/data/report-engine.db
# Client config directory (default: ./config/clients)
# CONFIG_DIR=./config/clients
# Directory for generated reports (default: ./out); in the container /data/out
# OUT_DIR=./out
# Your agency/studio name in the report and email (optional; without it no name is shown)
# BRAND_NAME=

# Search Console – service account JSON (mounted from the secrets/ directory)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gsc-service-account.json

# Worklog – fine-grained, read-only token for the client repos
GITHUB_TOKEN=

# Cloudflare Web Analytics – API token with Account → Account Analytics → Read, and the account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# PageSpeed Insights – Google Cloud API key, restricted to the PageSpeed Insights API
PAGESPEED_API_KEY=

# AI text layer: used only by `report --live` (this is how cron runs it)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Email – HTTP API of our own Postal server (Postal: server API credential, "API" type)
POSTAL_URL=
POSTAL_API_KEY=
EMAIL_FROM=
# Recipient of the preview sent after the report
EMAIL_PREVIEW_TO=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_REPORTS=
R2_BUCKET_BACKUPS=
REPORT_BASE_URL=

# External dead-man ping (healthchecks.io etc.) at the end of the uptime round; the URL counts as a secret. Do not leave it empty: delete or comment it out.
# HEALTHCHECK_URL=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
