# Rootless Podman Quadlet. Copy to: ~/.config/containers/systemd/report-engine.container
# Verification: see docs/operations.md. deploy/run.sh reads the Image/Volume/Secret/
# EnvironmentFile/UserNS/User lines from THIS file: change them in one place only.
[Unit]
Description=report-engine ütemező
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/naturalmoods/report-engine:latest
ContainerName=report-engine
AutoUpdate=registry
# Logs go to the journal (journalctl --user -u report-engine).
LogDriver=journald

# The host user is uid/gid 1000 in the container (the image's `node` user): the ~/report-engine/data
# directory is thus writable without chown and the config is readable. The host uid can be anything.
UserNS=keep-id:uid=1000,gid=1000
User=1000
Volume=%h/report-engine/data:/data
Volume=%h/report-engine/config:/app/config:ro

# Non-secret env (TZ, LLM_MODEL, EMAIL_FROM, REPORT_BASE_URL, R2_ACCOUNT_ID, HEALTHCHECK_URL...), chmod 600.
EnvironmentFile=%h/report-engine/report-engine.env

# Secrets (created with podman secret create). run.sh also picks up every Secret= line.
Secret=re-anthropic-api-key,type=env,target=ANTHROPIC_API_KEY
Secret=re-github-token,type=env,target=GITHUB_TOKEN
Secret=re-postal-api-key,type=env,target=POSTAL_API_KEY
Secret=re-r2-access-key-id,type=env,target=R2_ACCESS_KEY_ID
Secret=re-r2-secret-access-key,type=env,target=R2_SECRET_ACCESS_KEY
Secret=re-telegram-bot-token,type=env,target=TELEGRAM_BOT_TOKEN
Secret=re-gsc-service-account,type=mount,target=/run/secrets/gsc-service-account.json,uid=1000,mode=0400

# The image's HEALTHCHECK may not survive in OCI format, so it is also specified here.
# No HealthOnFailure: status --health also returns 1 on stale data (e.g. a Google API outage), and a restart
# would not fix that, only create a loop. The failure is signalled by the Telegram alert and the external dead-man ping.
HealthCmd=node src/cli/index.ts status --health
HealthInterval=5m
HealthTimeout=30s
HealthStartPeriod=30s

[Service]
Restart=always
RestartSec=10
# On first start, pulling the image may take longer than the default timeout.
TimeoutStartSec=900

[Install]
WantedBy=default.target
